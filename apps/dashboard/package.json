{
  "name": "@aegisgate/dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit.test.mjs",
    "integration": "node --test tests/integration.test.mjs",
    "fmt": "prettier --write app lib tests *.mjs *.json *.md",
    "fmt:check": "prettier --check app lib tests *.mjs *.json *.md"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "typescript-eslint": "8.72.2",
    "typescript": "6.0.3",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.7"
  }
}
