ecute background HTTP2 tasks.\n     pub fn timer<M>(&mut self, timer: M) -> &mut Builder<Ex>\n     where"},{"sha":"72f28ecbbdea82ce0244052e5e70a60fee359483","filename":"src/server/conn/http2.rs","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/hyperium/hyper/blob/b638fc0de351987f3eaffa2bdabd393c8679a9e8/src%2Fserver%2Fconn%2Fhttp2.rs","raw_url":"https://github.com/hyperium/hyper/raw/b638fc0de351987f3eaffa2bdabd393c8679a9e8/src%2Fserver%2Fconn%2Fhttp2.rs","contents_url":"https://api.github.com/repos/hyperium/hyper/contents/src%2Fserver%2Fconn%2Fhttp2.rs?ref=b638fc0de351987f3eaffa2bdabd393c8679a9e8","patch":"@@ -120,6 +120,11 @@ impl<E> Builder<E> {\n         }\n     }\n \n+    /// Returns the executor this builder was created with.\n+    pub fn executor(&self) -> &E {\n+        &self.exec\n+    }\n+\n     /// Configures the maximum number of pending reset streams allowed before a GOAWAY will be sent.\n     ///\n     /// This will default to the default value set by the [`h2` crate](https://crates.io/crates/h2)."}]}