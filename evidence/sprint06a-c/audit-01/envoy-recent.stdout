0121559","id":680121559,"node_id":"RA_kwDOA-MW784oidTX","name":"envoy-contrib-1.40.2-linux-x86_64","label":"","uploader":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/repos","events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":166039328,"digest":"sha256:4fcda3d480acd6124c8a85487d79992b00f2e008cab25532ae28be764a92cdaa","download_count":602,"created_at":"2026-10-27T01:52:04Z","updated_at":"2026-10-27T01:52:10Z","browser_download_url":"https://github.com/envoyproxy/envoy/releases/download/v1.40.2/envoy-contrib-1.40.2-linux-x86_64"}],"tarball_url":"https://api.github.com/repos/envoyproxy/envoy/tarball/v1.40.2","zipball_url":"https://api.github.com/repos/envoyproxy/envoy/zipball/v1.40.2","body":"**Summary of changes**:\r\n\r\n* Upstream security fixes:\r\n  - [eMudhra intermediate CA compromise](https://emudhra.we-have-a-problem.com/):\r\n    release: updated the `distroless` docker image base to pick up the patched\r\n    `ca-certificates` package (`20250419+deb13u1`), so it no longer trusts the roots of the\r\n    compromised eMudhra intermediate CAs. The distroless image released in 1.40.1 still\r\n    shipped the unpatched bundle.\r\n\r\n**Docker images**:\r\n    https://hub.docker.com/r/envoyproxy/envoy/tags?page=1&name=v1.40.2\r\n**Docs**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.40.2/\r\n**Release notes**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.40.2/version_history/v1.40/v1.40.2\r\n**Full changelog**:\r\n    https://github.com/envoyproxy/envoy/compare/v1.40.1...v1.40.2\r\n\r\nSigned-off-by: Jonh Wendell <jwendell@redhat.com>\r\nSigned-off-by: Ryan Northey <ryan@synca.io>\r\n","reactions":{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/424953653/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}},{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/424919221","assets_url":"https://api.github.com/repos/envoyproxy/envoy/releases/424919221/assets","upload_url":"https://uploads.github.com/repos/envoyproxy/envoy/releases/424919221/assets{?name,label}","html_url":"https://github.com/envoyproxy/envoy/releases/tag/v1.39.6","id":424919221,"author":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","