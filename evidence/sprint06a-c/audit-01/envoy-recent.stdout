ream","state":"uploaded","size":155694632,"digest":"sha256:249cfa9ef29e61e044c6d14aa4f06bbe273d059acfb798316c39c6a72d9ce043","download_count":8,"created_at":"2026-10-23T00:59:16Z","updated_at":"2026-10-23T00:59:21Z","browser_download_url":"https://github.com/envoyproxy/envoy/releases/download/v1.39.5/envoy-contrib-1.39.5-linux-aarch_64"},{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/assets/667567734","id":667567734,"node_id":"RA_kwDOA-MW784nykZ2","name":"envoy-contrib-1.39.5-linux-x86_64","label":"","uploader":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/repos","events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":164832160,"digest":"sha256:662238b8870d9c008b26707eba015c21f96014910a4406add435dfc4bed01148","download_count":9,"created_at":"2026-10-23T00:59:21Z","updated_at":"2026-10-23T00:59:26Z","browser_download_url":"https://github.com/envoyproxy/envoy/releases/download/v1.39.5/envoy-contrib-1.39.5-linux-x86_64"}],"tarball_url":"https://api.github.com/repos/envoyproxy/envoy/tarball/v1.39.5","zipball_url":"https://api.github.com/repos/envoyproxy/envoy/zipball/v1.39.5","body":"**Summary of changes**:\r\n\r\n* Upstream security fixes:\r\n  - [eMudhra intermediate CA compromise](https://emudhra.we-have-a-problem.com/):\r\n    the private keys of several eMudhra intermediate CA certificates were compromised.\r\n    - release: updated the Envoy docker images so they no longer trust the compromised\r\n      eMudhra CAs.\r\n    - mobile: removed the `AAA Certificate Services` and `emSign ECC Root CA - G3` roots\r\n      from the root certificate bundle built into Envoy Mobile. Servers whose certificate\r\n      chains only lead to these roots are no longer trusted by Envoy Mobile when it uses\r\n      its built-in bundle.\r\n    - dns_resolver: updated the `webpki-roots` and `rustls-webpki` crates used by the\r\n      built-in Hickory DNS resolver, so DNS-over-TLS and DNS-over-HTTPS upstreams no longer\r\n      trust the compromised eMudhra intermediate CAs.\r\n\r\n* Behavior changes:\r\n  - contrib/istio: peer metadata conversion takes a peer's app name and version from the\r\n    `app` and `version` labels again, falling back to `app.kubernetes.io/name` and\r\n    `app.kubernetes.io/version` only when those are absent or empty. This makes peer-reported\r\n    `source_app`, `destination_app`, `source_version` and `destination_version` match the\r\n    values a workload reports for itself.\r\n\r\n**Docker images**:\r\n    https://hub.docker.com/r/envoyproxy/envoy/tags?page=1&name=v1.39.5\r\n**Docs**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.39.5/\r\n**Release notes**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.39.5/version_history/v1.39/v1.39.5\r\n**Full changelog**:\r\n    https://github.com/envoyproxy/envoy/compare/v1.39.4...v1.39.5\r\n\r\nSigned-off-by: Jonh Wendell <jwendell@redhat.com>\r\nSigned-off-by: Ryan Northey <ryan@synca.io>"}]