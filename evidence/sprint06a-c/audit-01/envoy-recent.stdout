gelog**:\r\n    https://github.com/envoyproxy/envoy/compare/v1.38.8...v1.38.9\r\n\r\nSigned-off-by: Jonh Wendell <jwendell@redhat.com>\r\nSigned-off-by: Ryan Northey <ryan@synca.io>\r\n"},{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/424816510","assets_url":"https://api.github.com/repos/envoyproxy/envoy/releases/424816510/assets","upload_url":"https://uploads.github.com/repos/envoyproxy/envoy/releases/424816510/assets{?name,label}","html_url":"https://github.com/envoyproxy/envoy/releases/tag/v1.37.11","id":424816510,"author":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/repos","events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOA-MW784ZUi9-","tag_name":"v1.37.11","target_commitish":"0ce6eee982e6df4a873b28184b396eeacfad938f","name":"v1.37.11","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-26T21:24:27Z","updated_at":"2026-10-26T22:07:32Z","published_at":"2026-10-26T21:59:50Z","assets":[{"url":"https://api.github.com/repos/envoyproxy/envoy/releas