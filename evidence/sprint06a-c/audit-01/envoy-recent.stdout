_download_url":"https://github.com/envoyproxy/envoy/releases/download/v1.37.11/envoy-contrib-1.37.11-linux-aarch_64"},{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/assets/679608433","id":679608433,"node_id":"RA_kwDOA-MW784oggBx","name":"envoy-contrib-1.37.11-linux-x86_64","label":"","uploader":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/repos","events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":117296120,"digest":"sha256:4710195e85858d6478442b933a0e66628e72567561e9801339069979ef03063f","download_count":11,"created_at":"2026-10-26T21:59:51Z","updated_at":"2026-10-26T21:59:56Z","browser_download_url":"https://github.com/envoyproxy/envoy/releases/download/v1.37.11/envoy-contrib-1.37.11-linux-x86_64"}],"tarball_url":"https://api.github.com/repos/envoyproxy/envoy/tarball/v1.37.11","zipball_url":"https://api.github.com/repos/envoyproxy/envoy/zipball/v1.37.11","body":"**Summary of changes**:\r\n\r\n* Upstream security fixes:\r\n  - [eMudhra intermediate CA compromise](https://emudhra.we-have-a-problem.com/):\r\n    release: the `distroless` docker image now uses the patched `ca-certificates` package\r\n    (`20250419~deb12u2`) from Debian bookworm, so it no longer trusts the roots of the\r\n    compromised eMudhra intermediate CAs. The distroless image released in 1.37.10 still\r\n    shipped the unpatched bundle.\r\n\r\n**Docker images**:\r\n    https://hub.docker.com/r/envoyproxy/envoy/tags?page=1&name=v1.37.11\r\n**Docs**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.37.11/\r\n**Release notes**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.37.11/version_history/v1.37/v1.37.11\r\n**Full changelog**:\r\n    https://github.com/envoyproxy/envoy/compare/v1.37.10...v1.37.11\r\n\r\nSigned-off-by: Jonh Wendell <jwendell@redhat.com>\r\nSigned-off-by: Ryan Northey <ryan@synca.io>\r\n"},{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/421381233","assets_url":"https://api.github.com/repos/envoyproxy/envoy/releases/421381233/assets","upload_url":"https://uploads.github.com/repos/envoyproxy/envoy/releases/421381233/assets{?name,label}","html_url":"https://github.com/envoyproxy/envoy/releases/tag/v1.40.1","id":421381233,"author":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%