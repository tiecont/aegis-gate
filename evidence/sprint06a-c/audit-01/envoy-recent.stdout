blish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/repos","events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":157933864,"digest":"sha256:8d9bbe8d4f362eec4ea19001d7b563a3a4fe543ba519eb038f40d667abf88eb7","download_count":10,"created_at":"2026-10-23T02:09:43Z","updated_at":"2026-10-23T02:09:49Z","browser_download_url":"https://github.com/envoyproxy/envoy/releases/download/v1.40.1/envoy-contrib-1.40.1-linux-aarch_64"},{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/assets/667698737","id":667698737,"node_id":"RA_kwDOA-MW784nzEYx","name":"envoy-contrib-1.40.1-linux-x86_64","label":"","uploader":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/repos","events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":166039328,"digest":"sha256:c63c1e760cf5efa94e8e42e9764f2fde7cdea9c6fae943bd773e9dde6c114548","download_count":39,"created_at":"2026-10-23T02:09:42Z","updated_at":"2026-10-23T02:09:49Z","browser_download_url":"https://github.com/envoyproxy/envoy/releases/download/v1.40.1/envoy-contrib-1.40.1-linux-x86_64"}],"tarball_url":"https://api.github.com/repos/envoyproxy/envoy/tarball/v1.40.1","zipball_url":"https://api.github.com/repos/envoyproxy/envoy/zipball/v1.40.1","body":"**Summary of changes**:\r\n\r\n* Upstream security fixes:\r\n  - [eMudhra intermediate CA compromise](https://emudhra.we-have-a-problem.com/):\r\n    the private keys of several eMudhra intermediate CA certificates were compromised.\r\n    - release: updated the Envoy docker images so they no longer trust the compromised\r\n      eMudhra CAs.\r\n    - mobile: removed the `AAA Certificate Services` and `emSign ECC Root CA - G3` roots\r\n      from the root certificate bundle built into Envoy Mobile. Servers whose certificate\r\n      chains only lead to these roots are no longer trusted by Envoy Mobile when it uses\r\n      its built-in bundle.\r\n    - dns_resolver: updated the `webpki-roots` and `rustls-webpki` crates used by the\r\n      built-in Hickory DNS resolver, so DNS-over-TLS and DNS-over-HTTPS upstreams no longer\r\n      trust the compromised eMudhra intermediate CAs.\r\n\r\n* Behavior changes:\r\n  - contrib/istio: peer metadata conversion takes a peer's app name and version from the\r\n    `app` and `version` labels again, falling back to `app.kubernetes.io/name` and\r\n    `app.kubernetes.io/version` only when those are absent or empty. This makes peer-reported\r\n    `source_app`, `destination_app`, `source_version` and `destination_version` match the\r\n    values a workload reports for itself.\r\n\r\n**Docker images**:\r\n    https://hub.docker.com/r/envoyproxy/envoy/tags?page=1&name=v1.40.1\r\n**Docs**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.40.1/\r\n**Release notes**:\r\n    https://www.envoyproxy.io/docs/envoy/v1.40.1/version_history/v1.40/v1.40.1\r\n**Full changelog**:\r\n    https://github.com/envoyproxy/envoy/compare/v1.40.0...v1.40.1\r\n\r\nSigned-off-by: Jonh Wendell <jwendell@redhat.com>\r\nSigned-off-by: Ryan Northey <ryan@synca.io>"},{"url":"https://api.github.com/repos/envoyproxy/envoy/releases/421346853","assets_url":"https://api.github.com/repos/envoyproxy/envoy/releases/421346853/assets","upload_url":"https://uploads.github.com/repos/envoyproxy/envoy/releases/421346853/assets{?name,label}","html_url":"https://github.com/envoyproxy/envoy/releases/tag/v1.39.5","id":421346853,"author":{"login":"publish-envoy[bot]","id":140627008,"node_id":"BOT_kgDOCGHMQA","avatar_url":"https://avatars.githubusercontent.com/in/367053?v=4","gravatar_id":"","url":"https://api.github.com/users/publish-envoy%5Bbot%5D","html_url":"https://github.com/apps/publish-envoy","followers_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/followers","following_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/repos","events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/publish-envoy%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOA-MW784ZHT4l","tag_name":"v1.39.5","target_commitish":"abcc910ca2c0690d7dbd96557f6dbc8f5090aaa0","name":"v1.39.5","d