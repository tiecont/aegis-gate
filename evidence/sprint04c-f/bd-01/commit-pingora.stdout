/drcaramelsyrup/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"drcaramelsyrup","id":834403,"node_id":"MDQ6VXNlcjgzNDQwMw==","avatar_url":"https://avatars.githubusercontent.com/u/834403?v=4","gravatar_id":"","url":"https://api.github.com/users/drcaramelsyrup","html_url":"https://github.com/drcaramelsyrup","followers_url":"https://api.github.com/users/drcaramelsyrup/followers","following_url":"https://api.github.com/users/drcaramelsyrup/following{/other_user}","gists_url":"https://api.github.com/users/drcaramelsyrup/gists{/gist_id}","starred_url":"https://api.github.com/users/drcaramelsyrup/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/drcaramelsyrup/subscriptions","organizations_url":"https://api.github.com/users/drcaramelsyrup/orgs","repos_url":"https://api.github.com/users/drcaramelsyrup/repos","events_url":"https://api.github.com/users/drcaramelsyrup/events{/privacy}","received_events_url":"https://api.github.com/users/drcaramelsyrup/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"96e9abd7c3e37aa6cc36eacfd87dbfcdf13fe947","url":"https://api.github.com/repos/cloudflare/pingora/commits/96e9abd7c3e37aa6cc36eacfd87dbfcdf13fe947","html_url":"https://github.com/cloudflare/pingora/commit/96e9abd7c3e37aa6cc36eacfd87dbfcdf13fe947"}],"stats":{"total":152,"additions":85,"deletions":67},"files":[{"sha":"e636590e02d909a858ccb64a50b1d0fbd4d6638f","filename":"CHANGELOG.md","status":"modified","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/CHANGELOG.md","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/CHANGELOG.md","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/CHANGELOG.md?ref=f86ffda5d3ae5c3baf5125682138b33b26c01b08","patch":"@@ -2,6 +2,24 @@\n \n All notable changes to this project will be documented in this file.\n \n+## [0.9.1](https://github.com/cloudflare/pingora/compare/0.9.0...0.9.1) - 2026-11-02\n+\n+\n+**🔒 Security**\n+\n+* Require zstd 0.14.3, and through it zstd-safe 8.2.0 and zstd-sys 2.1.2, so dependency resolution cannot select zstd crates affected by RUSTSEC-2026-0391, RUSTSEC-2026-0395 through RUSTSEC-2026-0406, or RUSTSEC-2026-0410.\n+\n+**🐛 Bug Fixes**\n+\n+* Fix a panic on every accepted and outgoing connection with tokio 1.54 and later, which rejects zero-capacity buffered readers (#1059).\n+* Fix the docs.rs build of the `pingora` crate, which failed for 0.9.0 (#1018).\n+* Fix a panic in `pingora-limits` `Estimator::incr` when a counter overflows in builds with overflow checks enabled (#1041).\n+\n+**⚙️ Miscellaneous Tasks**\n+\n+* Ignore RustSec advisories for rustls 0.21, webpki-roots 0.26, rustls-webpki 0.101 and crypto-bigint 0.5.5, which reach the lockfile only through optional transitive dependencies and have no compatible fixed release.\n+* Update HTTP/2 rejection tests for h2 releases that reject conflicting Content-Length headers in the codec.\n+\n ## [0.9.0](https://github.com/cloudflare/pingora/compare/0.8.0...0.9.0) - 2026-09-04\n \n ### ✨ Highlights"},{"sha":"44c05d183d6089735a84130d9d88886518fb5604","filename":"pingora-boringssl/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-boringssl%2FCargo.toml","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-boringssl%2FCargo.toml","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/pingora-boringssl%2FCargo.toml?ref=f86ffda5d3ae5c3baf5125682138b33b26c01b08","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"pingora-boringssl\"\n-version = \"0.9.0\"\n+version = \"0.9.1\"\n authors = [\"Yuchen Wu <yuchen@cloudflare.com>\"]\n license = \"Apache-2.0\"\n edition = \"2021\""},{"sha":"f594ee5fa6a416fb0ec34b7bc8ca613bfba4e52b","filename":"pingora-cache/Cargo.toml","status":"modified","additions":7,"deletions":7,"changes":14,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-cache%2FCargo.toml","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-cache%2FCargo.toml","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/pingora-cache%2FCargo.toml?ref=f86ffda5d3ae5c3baf5125682138b33b26c01b08","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"pingora-cache\"\n-version = \"0.9.0\"\n+version = \"0.9.1\"\n authors = [\"Yuchen Wu <yuchen@cloudflare.com>\"]\n license = \"Apache-2.0\"\n edition = \"2021\"\n@@ -18,12 +18,12 @@ name = \"pingora_cache\"\n path = \"src/lib.rs\"\n \n [dependencies]\n-pingora-core = { version = \"0.9.0\", path = \"../pingora-core\", default-features = false }\n-pingora-error = { version = \"0.9.0\", path = \"../pingora-error\" }\n-pingora-header-serde = { version = \"0.9.0\", path = \"../pingora-header-serde\" }\n-pingora-http = { version = \"0.9.0\", path = \"../pingora-http\" }\n-pingora-lru = { version = \"0.9.0\", path = \"../pingora-lru\" }\n-pingora-timeout = { version = \"0.9.0\", path = \"../pingora-timeout\" }\n+pingora-core = { version = \"0.9.1\", path = \"../pingora-core\", default-features = false }\n+pingora-error = { version = \"0.9.1\", path = \"../pingora-error\" }\n+pingora-header-serde = { version = \"0.9.1\", path = \"../pingora-header-serde\" }\n+pingora-http = { version = \"0.9.1\", path = \"../pingora-http\" }\n+pingora-lru = { version = \"0.9.1\", path = \"../pingora-lru\" }\n+pingora-timeout = { version = \"0.9.1\", path = \"../pingora-timeout\" }\n bstr = { workspace = true }\n http = { workspace = true }\n indexmap = \"1\""},{"sha":"10664609a316458b422e2a2bd29c8768ef5a4d3f","filename":"pingora-core/Cargo.toml","status":"modified","additions":10,"deletions":10,"changes":20,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-core%2FCargo.toml","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-core%2FCargo.toml","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/pingora-core%2FCargo.toml?ref=f86ffda5d3ae5c3baf5125682138b33b26c01b08","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"pingora-core\"\n-version = \"0.9.0\"\n+version = \"0.9.1\"\n authors = [\"Yuchen Wu <yuchen@cloudflare.com>\"]\n license = \"Apache-2.0\"\n edition = \"2021\"\n@@ -19,15 +19,15 @@ name = \"pingora_core\"\n path = \"src/lib.rs\"\n \n [dependencies]\n-pingora-runtime = { version = \"0.9.0\", path = \"../pingora-runtime\" }\n-pingora-openssl = { version = \"0.9.0\", path = \"../pingora-openssl\", optional = true }\n-pingora-boringssl = { version = \"0.9.0\", path = \"../pingora-boringssl\", optional = true }\n-pingora-pool = { version = \"0.9.0\", path = \"../pingora-pool\" }\n-pingora-error = { version = \"0.9.0\", path = \"../pingora-error\" }\n-pingora-timeout = { version = \"0.9.0\", path = \"../pingora-timeout\" }\n-pingora-http = { version = \"0.9.0\", path = \"../pingora-http\" }\n-pingora-rustls = { version = \"0.9.0\", path = \"../pingora-rustls\", optional = true }\n-pingora-s2n = { version = \"0.9.0\", path = \"../pingora-s2n\", optional = true }\n+pingora-runtime = { version = \"0.9.1\", path = \"../pingora-runtime\" }\n+pingora-openssl = { version = \"0.9.1\", path = \"../pingora-openssl\", optional = true }\n+pingora-boringssl = { version = \"0.9.1\", path = \"../pingora-boringssl\", optional = true }\n+pingora-pool = { version = \"0.9.1\", path = \"../pingora-pool\" }\n+pingora-error = { version = \"0.9.1\", path = \"../pingora-error\" }\n+pingora-timeout = { version = \"0.9.1\", path = \"../pingora-timeout\" }\n+pingora-http = { version = \"0.9.1\", path = \"../pingora-http\" }\n+pingora-rustls = { version = \"0.9.1\", path = \"../pingora-rustls\", optional = true }\n+pingora-s2n = { version = \"0.9.1\", path = \"../pingora-s2n\", optional = true }\n bstr = { workspace = true }\n tokio = { workspace = true, features = [\"net\", \"rt-multi-thread\", \"signal\"] }\n tokio-stream = { workspace = true }"},{"sha":"1f247b7e923e8f91e087a8ecbadb821f945f3c40","filename":"pingora-error/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-error%2FCargo.toml","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-error%2FCargo.toml","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/pingora-error%2FCargo.toml?ref=f86ffda5d3ae5c3baf5125682138b33b26c01b08","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"pingora-error\"\n-version = \"0.9.0\"\n+version = \"0.9.1\"\n authors = [\"Yuchen Wu <yuchen@cloudflare.com>\"]\n license = \"Apache-2.0\"\n edition = \"2021\""},{"sha":"b35dd1e4db589242f8916c5b8ec07ab911e38a75","filename":"pingora-foundations/Cargo.toml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-foundations%2FCargo.toml","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-foundations%2FCargo.toml","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/pingora-foundations%2FCargo.toml?ref=f86ffda5d3ae5c3baf5125682138b33b26c01b08","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"pingora-foundations\"\n-version = \"0.9.0\"\n+version = \"0.9.1\"\n authors = [\"Pingora Team at Cloudflare <pingora@cloudflare.com>\"]\n license = \"Apache-2.0\"\n edition = \"2021\"\n@@ -17,7 +17,7 @@ name = \"pingora_foundations\"\n path = \"src/lib.rs\"\n \n [dependencies]\n-pingora-core = { version = \"0.9.0\", path = \"../pingora-core\", default-features = false, optional = true }\n+pingora-core = { version = \"0.9.1\", path = \"../pingora-core\", default-features = false, optional = true }\n # Adopt Foundations minor releases deliberately because they may raise the effective MSRV.\n foundations = { version = \"~5.6.5\", default-features = false }\n async-trait = { workspace = true, optional = true }"},{"sha":"15ba851962d12aa0bb86b170d354cd3f2440aa65","filename":"pingora-header-serde/Cargo.toml","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-header-serde%2FCargo.toml","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-header-serde%2FCargo.toml","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/pingora-header-serde%2FCargo.toml?ref=f86ffda5d3ae5c3baf5125682138b33b26c01b08","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"pingora-header-serde\"\n-version = \"0.9.0\"\n+version = \"0.9.1\"\n authors = [\"Yuchen Wu <yuchen@cloudflare.com>\"]\n license = \"Apache-2.0\"\n edition = \"2021\"\n@@ -27,6 +27,6 @@ zstd-safe = { version = \"8.2.0\", features = [\"std\"] }\n http = { workspace = true }\n bytes = { workspace = true }\n httparse = { workspace = true }\n-pingora-error = { version = \"0.9.0\", path = \"../pingora-error\" }\n-pingora-http = { version = \"0.9.0\", path = \"../pingora-http\" }\n+pingora-error = { version = \"0.9.1\", path = \"../pingora-error\" }\n+pingora-http = { version = \"0.9.1\", path = \"../pingora-http\" }\n thread_local = \"1.0\""},{"sha":"1e10d0f8d2c6f33bb344a6efadb9f4ccf1fcfaf9","filename":"pingora-http/Cargo.toml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/cloudflare/pingora/blob/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-http%2FCargo.toml","raw_url":"https://github.com/cloudflare/pingora/raw/f86ffda5d3ae5c3baf5125682138b33b26c01b08/pingora-http%2FCargo.toml","con