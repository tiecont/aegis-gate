123: // Adjust the concurrent stream limit if the negotiated concurrent stream limit
124: // is lower than the local max configured streams.
125: //
126: // Note: if multiple streams are assigned to a connection before the settings
127: // are received, they may still be reset by the peer. This could be avoided by
128: // not considering http/2 connections connected until the SETTINGS frame is
129: // received, but that would result in a latency penalty instead.
130: void MultiplexedActiveClientBase::onSettings(ReceivedSettings& settings) {
131:   if (settings.maxConcurrentStreams().has_value()) {
132:     uint32_t old_pool_contribution = currentUnusedCapacity();
133:     if (parent().cache() && parent().origin().has_value()) {
134:       parent().cache()->setConcurrentStreams(*parent().origin(),
135:                                              settings.maxConcurrentStreams().value());
136:     }
137:     concurrent_stream_limit_ =
138:         std::min(settings.maxConcurrentStreams().value(), configured_stream_limit_);
139: 
140:     // Compute raw signed capacity to determine debt (the negative portion not tracked in pool).
141:     int64_t new_raw_capacity = static_cast<int64_t>(concurrent_stream_limit_) - numActiveStreams();
142:     new_raw_capacity = std::min<int64_t>(remaining_streams_, new_raw_capacity);
143:     uint32_t new_pool_contribution = static_cast<uint32_t>(std::max<int64_t>(0, new_raw_capacity));
144: 
145:     if (state() == ActiveClient::State::Ready && new_raw_capacity <= 0) {
146:       parent_.transitionActiveClientState(*this, ActiveClient::State::Busy);
147:     } else if (state() == ActiveClient::State::Busy && new_raw_capacity > 0) {
148:       parent_.transitionActiveClientState(*this, ActiveClient::State::Ready);
149:     }
150: 
151:     capacity_debt_ = static_cast<uint32_t>(std::max<int64_t>(0, -new_raw_capacity));
152: 
153:     if (old_pool_contribution > new_pool_contribution) {
