318: FALSE_RUNTIME_GUARD(envoy_restart_features_use_cached_grpc_client_for_xds);
319: // Runtime guard to revert back to old non-RFC-compliant CONNECT behavior without Host header.
320: // TODO(vinaykul): Drop this false-runtime-guard when deemed safe with RFC 9110 compliant CONNECT.
321: FALSE_RUNTIME_GUARD(envoy_reloadable_features_http_11_proxy_connect_legacy_format);
322: // TODO(tsaarni): Flip to true after prod testing or remove.
323: FALSE_RUNTIME_GUARD(envoy_reloadable_features_fixed_heap_use_allocated);
324: // Flip back to true once performance aligns with nghttp2 and
325: // https://github.com/envoyproxy/envoy/issues/40070 is resolved.
326: FALSE_RUNTIME_GUARD(envoy_reloadable_features_http2_use_oghttp2);
327: 
328: FALSE_RUNTIME_GUARD(envoy_reloadable_features_least_request_lb_count_pending_requests);
329: // When enabled, dynamic modules metrics will be registered as custom stat namespaces, causing
330: // the namespace prefix to be stripped from prometheus output and no envoy_ prefix added.
331: // This is the legacy behavior. When disabled which is the default, metrics appear with the
332: // standard envoy_ prefix followed by the namespace.
333: FALSE_RUNTIME_GUARD(envoy_reloadable_features_dynamic_modules_strip_custom_stat_prefix);
334: // TODO(haoyuewang): Flip true after prod testing.
335: FALSE_RUNTIME_GUARD(envoy_reloadable_features_quic_disable_data_read_immediately);
336: // TODO(yavlasov): Flip to true after prod testing.
337: FALSE_RUNTIME_GUARD(envoy_reloadable_features_strict_chunk_parsing);
338: 
339: // Delay route selection in tcp_proxy until just before the upstream connection is established
340: FALSE_RUNTIME_GUARD(envoy_reloadable_features_tcp_proxy_delay_route_selection);
341: 
342: // Enable histograms of HTTP/2 header sizes, including cookie size.
343: FALSE_RUNTIME_GUARD(envoy_reloadable_features_http2_record_histograms);
344: 
345: // TODO: Flip back to true once TLS certificate compression with brotli (RFC 8879) has been
346: // validated in production. When disabled, QUIC retains zlib-only compression while TCP TLS has
347: // no certificate compression.
348: FALSE_RUNTIME_GUARD(envoy_reloadable_features_tls_certificate_compression_brotli);
