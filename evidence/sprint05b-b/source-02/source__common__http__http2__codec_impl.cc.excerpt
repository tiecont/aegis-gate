1876: int ConnectionImpl::setAndCheckCodecCallbackStatus(Status&& status) {
1877:   // Keep the error status that caused the original failure. Subsequent
1878:   // error statuses are silently discarded.
1879:   codec_callback_status_.Update(std::move(status));
1880:   if (codec_callback_status_.ok() && connection_.state() != Network::Connection::State::Open) {
1881:     if (!active_streams_.empty() || !raised_goaway_) {
1882:       codec_callback_status_ = codecProtocolError("Connection was closed while dispatching frames");
1883:     } else {
1884:       codec_callback_status_ = goAwayGracefulCloseError();
1885:     }
1886:   }
