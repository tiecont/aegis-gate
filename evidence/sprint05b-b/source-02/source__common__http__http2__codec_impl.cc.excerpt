1817: void ConnectionImpl::sendSettingsHelper(
1818:     const envoy::config::core::v3::Http2ProtocolOptions& http2_options, bool disable_push) {
1819:   absl::InlinedVector<http2::adapter::Http2Setting, 10> settings;
1820:   auto insertParameter = [&settings](const http2::adapter::Http2Setting& entry) mutable -> bool {
1821:     // Consider using a set as an intermediate data structure, rather than this ad-hoc
1822:     // deduplication.
1823:     const auto it = std::find_if(
1824:         settings.cbegin(), settings.cend(),
1825:         [&entry](const http2::adapter::Http2Setting& existing) { return entry.id == existing.id; });
1826:     if (it != settings.end()) {
1827:       return false;
1828:     }
1829:     settings.push_back(entry);
1830:     return true;
1831:   };
1832: 
1833:   // Universally disable receiving push promise frames as we don't currently
1834:   // support them.
1835:   // NOTE: This is a special case with respect to custom parameter overrides in
1836:   // that server push is not supported and therefore not end user configurable.
1837:   if (disable_push) {
1838:     settings.push_back({static_cast<int32_t>(http2::adapter::ENABLE_PUSH), disable_push ? 0U : 1U});
1839:   }
1840: 
1841:   for (const auto& it : http2_options.custom_settings_parameters()) {
1850: 
1851:   // Insert named parameters.
1852:   settings.insert(
1853:       settings.end(),
1854:       {{http2::adapter::HEADER_TABLE_SIZE, http2_options.hpack_table_size().value()},
1855:        {http2::adapter::ENABLE_CONNECT_PROTOCOL, http2_options.allow_connect()},
1856:        {http2::adapter::MAX_CONCURRENT_STREAMS, http2_options.max_concurrent_streams().value()},
1857:        {http2::adapter::INITIAL_WINDOW_SIZE, http2_options.initial_stream_window_size().value()}});
1858:   adapter_->SubmitSettings(settings);
1859: }
1860: 
1861: void ConnectionImpl::sendSettings(
1862:     const envoy::config::core::v3::Http2ProtocolOptions& http2_options, bool disable_push) {
1863:   sendSettingsHelper(http2_options, disable_push);
1864: 
1865:   const uint32_t initial_connection_window_size =
1866:       http2_options.initial_connection_window_size().value();
1867:   // Increase connection window size up to our default size.
1868:   if (initial_connection_window_size != INITIAL_CONNECTION_WINDOW_SIZE) {
1869:     ENVOY_CONN_LOG(debug, "updating connection-level initial window size to {}", connection_,
1870:                    initial_connection_window_size);
1871:     adapter_->SubmitWindowUpdate(0,
1872:                                  initial_connection_window_size - INITIAL_CONNECTION_WINDOW_SIZE);
1873:   }
1874: }
