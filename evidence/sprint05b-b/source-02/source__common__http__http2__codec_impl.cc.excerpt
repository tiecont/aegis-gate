991:     use_oghttp2_library_ =
992:         Runtime::runtimeFeatureEnabled("envoy.reloadable_features.http2_use_oghttp2");
993:   }
994:   if (http2_options.has_connection_keepalive()) {
995:     keepalive_interval_ = std::chrono::milliseconds(
996:         PROTOBUF_GET_MS_OR_DEFAULT(http2_options.connection_keepalive(), interval, 0));
997:     keepalive_timeout_ = std::chrono::milliseconds(
998:         PROTOBUF_GET_MS_REQUIRED(http2_options.connection_keepalive(), timeout));
999:     keepalive_interval_jitter_percent_ = PROTOBUF_GET_WRAPPED_OR_DEFAULT(
1000:         http2_options.connection_keepalive(), interval_jitter, 15.0);
1001: 
1002:     if (keepalive_interval_.count() > 0) {
1003:       keepalive_send_timer_ = connection.dispatcher().createTimer([this]() { sendKeepalive(); });
1004:     }
1005:     keepalive_timeout_timer_ =
1006:         connection.dispatcher().createTimer([this]() { onKeepaliveResponseTimeout(); });
1007: 
1008:     // This call schedules the initial interval, with jitter.
1009:     onKeepaliveResponse();
1010:   }
1011: }
