115: // for nghttp2 compatibility.
116: const int ERR_CALLBACK_FAILURE = -902;
117: const int INITIAL_CONNECTION_WINDOW_SIZE = ((1 << 16) - 1);
118: const int ERR_TEMPORAL_CALLBACK_FAILURE = -521;
119: const int ERR_REFUSED_STREAM = -533;
120: const int ERR_HTTP_HEADER = -531;
121: const int ERR_HTTP_MESSAGING = -532;
122: const int ERR_PROTO = -505;
123: const int ERR_STREAM_CLOSED = -510;
124: const int ERR_FLOW_CONTROL = -524;
