142:   // A comma-separated list of strings representing QUIC client connection options defined in
397:   //   Upstream responses are not affected by this setting.
398:   //
399:   // .. note::
400:   //
401:   //   This only affects client headers. It does not affect headers added by Envoy filters and does not have any
402:   //   impact if added to cluster config.
403:   HeadersWithUnderscoresAction headers_with_underscores_action = 5;
404: 
405:   // Optional maximum requests for both upstream and downstream connections.
406:   // If not specified, there is no limit.
407:   // Setting this parameter to ``1`` will effectively disable keep alive.
408:   // For HTTP/2 and HTTP/3, due to concurrent stream processing, the limit is approximate.
409:   google.protobuf.UInt32Value max_requests_per_connection = 6;
