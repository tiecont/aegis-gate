41: ActiveClient::ActiveClient(HttpConnPoolImplBase& parent,
42:                            OptRef<Upstream::Host::CreateConnectionData> data)
43:     : MultiplexedActiveClientBase(
44:           parent, calculateInitialStreamsLimit(parent.cache(), parent.origin(), parent.host()),
45:           parent.host()
46:               ->cluster()
47:               .httpProtocolOptions()
48:               .http2Options()
49:               .max_concurrent_streams()
50:               .value(),
51:           parent.host()->cluster().trafficStats()->upstream_cx_http2_total_, data) {}
