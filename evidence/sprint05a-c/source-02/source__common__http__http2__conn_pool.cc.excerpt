53: ConnectionPool::InstancePtr
54: allocateConnPool(Event::Dispatcher& dispatcher, Random::RandomGenerator& random_generator,
55:                  Upstream::HostConstSharedPtr host, Upstream::ResourcePriority priority,
56:                  const Network::ConnectionSocket::OptionsSharedPtr& options,
57:                  const Network::TransportSocketOptionsConstSharedPtr& transport_socket_options,
58:                  Upstream::ClusterConnectivityState& state,
59:                  Server::OverloadManager& overload_manager,
60:                  std::optional<HttpServerPropertiesCache::Origin> origin,
61:                  Http::HttpServerPropertiesCacheSharedPtr cache) {
62:   return std::make_unique<FixedHttpConnPoolImpl>(
63:       host, priority, dispatcher, options, transport_socket_options, random_generator, state,
64:       [](HttpConnPoolImplBase* pool) -> ::Envoy::ConnectionPool::ActiveClientPtr {
65:         // Create the connection up front so a failure (e.g. network namespace binding failure)
66:         // surfaces as a graceful connection failure rather than a crash when initializing the
67:         // client with a null connection.
68:         Upstream::Host::CreateConnectionData data =
69:             static_cast<Envoy::ConnectionPool::ConnPoolImplBase*>(pool)->host()->createConnection(
70:                 pool->dispatcher(), pool->socketOptions(), pool->transportSocketOptions());
71:         if (data.connection_ == nullptr) {
72:           return nullptr;
