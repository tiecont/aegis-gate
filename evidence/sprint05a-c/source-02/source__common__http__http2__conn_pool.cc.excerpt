17: uint32_t ActiveClient::calculateInitialStreamsLimit(
18:     Http::HttpServerPropertiesCacheSharedPtr http_server_properties_cache,
19:     std::optional<HttpServerPropertiesCache::Origin>& origin,
20:     Upstream::HostDescriptionConstSharedPtr host) {
21:   uint32_t initial_streams =
22:       host->cluster().httpProtocolOptions().http2Options().max_concurrent_streams().value();
23:   if (http_server_properties_cache && origin.has_value()) {
24:     uint32_t cached_concurrency =
25:         http_server_properties_cache->getConcurrentStreams(origin.value());
26:     if (cached_concurrency != 0 && cached_concurrency < initial_streams) {
27:       // Only use the cached concurrency if lowers the streams below the
28:       // configured max_concurrent_streams as Envoy should never send more
29:       // than max_concurrent_streams at once.
30:       initial_streams = cached_concurrency;
31:     }
32:   }
33:   uint32_t max_requests = MultiplexedActiveClientBase::maxStreamsPerConnection(
34:       host->cluster().maxRequestsPerConnection());
35:   if (max_requests < initial_streams) {
36:     initial_streams = max_requests;
37:   }
38:   return initial_streams;
39: }
