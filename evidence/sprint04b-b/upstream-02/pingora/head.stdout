{"sha":"3f87e92c982ee27c714506e16ae362776faea4aa","node_id":"C_kwDOJfWe5NoAKDNmODdlOTJjOTgyZWUyN2M3MTQ1MDZlMTZhZTM2Mjc3NmZhZWE0YWE","commit":{"author":{"name":"ewang","email":"ewang@cloudflare.com","date":"2026-11-07T05:33:10Z"},"committer":{"name":"Edward Wang","email":"dr.caramel.syrup@gmail.com","date":"2026-11-09T16:45:47Z"},"message":"Run the tests with cargo nextest in CI\n\nInstall cargo-nextest 0.9.151 and run the workspace tests through it,\nwhich is what .config/nextest.toml already expects for the integration\nbinaries that bind fixed ports. Doc tests still run with cargo test,\nbecause nextest does not run them. The h2 test that waits on\nhyperium/h2#983 is excluded with a filter expression instead of --skip.","tree":{"sha":"7d714c8c741a7bb602410b8272edc17c90b5576a","url":"https://api.github.com/repos/cloudflare/pingora/git/trees/7d714c8c741a7bb602410b8272edc17c90b5576a"},"url":"https://api.github.com/repos/cloudflare/pingora/git/commits/3f87e92c982ee27c714506e16ae362776faea4aa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/cloudflare/pingora/commits/3f87e92c982ee27c714506e16ae362776faea4aa","html_url":"https://github.com/cloudflare/pingora/commit/3f87e92c982ee27c714506e16ae362776faea4aa","comments_url":"https://api.github.com/repos/cloudflare/pingora/commits/3f87e92c982ee27c714506e16ae362776faea4aa/comments","author":{"login":"drcaramelsyrup","id":834403,"node_id":"MDQ6VXNlcjgzNDQwMw==","avatar_url":"https://avatars.githubusercontent.com/u/834403?v=4","gravatar_id":"","url":"https://api.github.com/users/drcaramelsyrup","html_url":"https://github.com/drcaramelsyrup","followers_url":"https://api.github.com/users/drcaramelsyrup/followers","following_url":"https://api.github.com/users/drcaramelsyrup/following{/other_user}","gists_url":"https://api.github.com/users/drcaramelsyrup/gists{/gist_id}","starred_url":"https://api.github.com/users/drcaramelsyrup/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/drcaramelsyrup/subscriptions","organizations_url":"https://api.github.com/users/drcaramelsyrup/orgs","repos_url":"https://api.github.com/users/drcaramelsyrup/repos","events_url":"https://api.github.com/users/drcaramelsyrup/events{/privacy}","received_events_url":"https://api.github.com/users/drcaramelsyrup/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"drcaramelsyrup","id":834403,"node_id":"MDQ6VXNlcjgzNDQwMw==","avatar_url":"https://avatars.githubusercontent.com/u/834403?v=4","gravatar_id":"","url":"https://api.github.com/users/drcaramelsyrup","html_url":"https://github.com/drcaramelsyrup","followers_url":"https://api.github.com/users/drcaramelsyrup/followers","following_url":"https://api.github.com/users/drcaramelsyrup/following{/other_user}","gists_url":"https://api.github.com/users/drcaramelsyrup/gists{/gist_id}","starred_url":"https://api.github.com/users/drcaramelsyrup/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/drcaramelsyrup/subscriptions","organizations_url":"https://api.github.com/users/drcaramelsyrup/orgs","repos_url":"https://api.github.com/users/drcaramelsyrup/repos","events_url":"https://api.github.com/users/drcaramelsyrup/events{/privacy}","received_events_url":"https://api.github.com/users/drcaramelsyrup/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b55929405adafad3b6fc14b34885af700866364e","url":"https://api.github.com/repos/cloudflare/pingora/commits/b55929405adafad3b6fc14b34885af700866364e","html_url":"https://github.com/cloudflare/pingora/commit/b55929405adafad3b6fc14b34885af700866364e"}],"stats":{"total":14,"additions":10,"deletions":4},"files":[{"sha":"a042da70823f275d388da11c7e45f9a70468572a","filename":".github/workflows/build.yml","status":"modified","additions":10,"deletions":4,"changes":14,"blob_url":"https://github.com/cloudflare/pingora/blob/3f87e92c982ee27c714506e16ae362776faea4aa/.github%2Fworkflows%2Fbuild.yml","raw_url":"https://github.com/cloudflare/pingora/raw/3f87e92c982ee27c714506e16ae362776faea4aa/.github%2Fworkflows%2Fbuild.yml","contents_url":"https://api.github.com/repos/cloudflare/pingora/contents/.github%2Fworkflows%2Fbuild.yml?ref=3f87e92c982ee27c714506e16ae362776faea4aa","patch":"@@ -82,15 +82,21 @@ jobs:\n             cargo check --workspace\n           fi\n \n-      - name: Run cargo test\n+      - name: Install cargo-nextest\n+        if: matrix.toolchain != '1.85.0'\n+        run: cargo install --locked cargo-nextest --version 0.9.151\n+\n+      # .config/nextest.toml serializes the integration binaries that bind\n+      # fixed ports.\n+      - name: Run cargo nextest\n         if: matrix.toolchain != '1.85.0'\n         # The skipped test needs an h2 client that discards late frames on\n         # forgotten streams, which no h2 release does yet (hyperium/h2#983).\n         run: >-\n-          cargo test --verbose --lib --bins --tests --no-fail-fast --\n-          --skip connectors::http::v2::tests::test_h2_late_frames_on_cancelled_streams_keep_connection\n+          cargo nextest run --workspace --no-fail-fast\n+          -E 'not test(test_h2_late_frames_on_cancelled_streams_keep_connection)'\n \n-      # Need to run doc tests separately.\n+      # nextest does not run doc tests, so run them separately.\n       # (https://github.com/rust-lang/cargo/issues/6669)\n       - name: Run cargo doc test\n         if: matrix.toolchain != '1.85.0'"}]}