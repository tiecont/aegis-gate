# Disposable local dependency only; production image release/signing stays gated.
FROM postgres:18.6-alpine@sha256:123b17998ccaf47e53b502e8c6a1e79afd8f579c6f3eec83c563da026f957395
RUN apk add --no-cache krb5-libs=1.22.3-r0 libxslt=1.1.43-r4 su-exec=0.3-r0 \
    && rm /usr/local/bin/gosu
COPY su-exec-wrapper.sh /usr/local/bin/gosu
RUN chmod 0755 /usr/local/bin/gosu \
    && /usr/local/bin/gosu postgres id -u | grep -qx 70
LABEL org.aegisgate.scope="unsafe-local-fixture" \
      org.aegisgate.base="postgres:18.6-alpine@sha256:123b17998ccaf47e53b502e8c6a1e79afd8f579c6f3eec83c563da026f957395"
