{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ErrorEnvelope",
  "definitions": {
    "OriginPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "name",
        "state",
        "generation",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "disabled",
            "retired"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "OriginEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pool_id",
        "project_id",
        "url",
        "hostname",
        "port",
        "state",
        "generation",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "hostname": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "enum": [
            443
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "disabled",
            "retired"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PoolRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool",
        "endpoints"
      ],
      "properties": {
        "pool": {
          "$ref": "#/definitions/OriginPool"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OriginEndpoint"
          }
        }
      }
    },
    "PoolCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "PoolUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "disabled",
            "retired"
          ]
        }
      }
    },
    "EndpointUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "state"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "disabled",
            "retired"
          ]
        }
      }
    },
    "FieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "before",
        "after"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "before": {
          "nullable": true
        },
        "after": {
          "nullable": true
        }
      }
    },
    "RevisionPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "changes",
        "approvable",
        "reasons"
      ],
      "properties": {
        "from": {
          "$ref": "#/definitions/ManagementResource"
        },
        "to": {
          "$ref": "#/definitions/ManagementResource"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldChange"
          }
        },
        "approvable": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PoolPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "changes"
      ],
      "properties": {
        "from": {
          "$ref": "#/definitions/PoolRevision"
        },
        "to": {
          "$ref": "#/definitions/PoolRevision"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldChange"
          }
        }
      }
    },
    "ManagementPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject"
      ],
      "properties": {
        "issuer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "ManagementID": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ManagementStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        }
      }
    },
    "ManagementName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ManagementMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "maxLength": 512
        },
        "subject": {
          "type": "string",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "security-admin",
            "developer",
            "billing-admin",
            "viewer"
          ]
        }
      }
    },
    "ManagementOrganization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "ManagementProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization_id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "OriginSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "PolicySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_required",
        "jwt_issuer",
        "jwt_audience"
      ],
      "properties": {
        "auth_required": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "jwt_issuer": {
          "type": "string",
          "format": "uri"
        },
        "jwt_audience": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "RouteSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "policy_id",
        "path",
        "methods"
      ],
      "oneOf": [
        {
          "required": [
            "origin_id"
          ],
          "not": {
            "required": [
              "origin_pool_id"
            ]
          }
        },
        {
          "required": [
            "origin_pool_id"
          ],
          "not": {
            "required": [
              "origin_id"
            ]
          }
        }
      ],
      "properties": {
        "origin_pool_id": {
          "type": "string",
          "format": "uuid"
        },
        "domain_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_id": {
          "type": "string",
          "format": "uuid"
        },
        "policy_id": {
          "type": "string",
          "format": "uuid"
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          }
        }
      }
    },
    "DomainInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "DomainClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "hostname",
        "state",
        "expires_at",
        "txt_name"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "hostname": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "active",
            "failed",
            "expired"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "txt_name": {
          "type": "string"
        },
        "proof": {
          "type": "string"
        }
      }
    },
    "ManagementResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "kind",
        "generation",
        "spec"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "domain",
            "origin",
            "policy",
            "route"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "spec": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "VerificationJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "domain_id",
        "state",
        "attempts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "domain_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "RouteApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "route_generation",
        "origin_generation",
        "policy_generation"
      ],
      "properties": {
        "decision_id": {
          "type": "integer",
          "minimum": 1
        },
        "origin_pool_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "route_id": {
          "type": "string",
          "format": "uuid"
        },
        "route_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "origin_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "AuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "action",
        "outcome",
        "at"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "allowed",
            "denied"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorDetail"
        }
      }
    },
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status"
      ],
      "properties": {
        "service": {
          "type": "string",
          "enum": [
            "control-api"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "alive"
          ]
        }
      }
    }
  }
}
