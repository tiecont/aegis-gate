{
  "name": "aegisgate-contract-tools",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "contracts:generate": "node scripts/module03-contracts.mjs --write && node scripts/contracts.mjs --write",
    "contracts:check": "node scripts/module03-contracts.mjs --check && node scripts/contracts.mjs --check",
    "contracts:test": "node --test scripts/contracts.test.mjs",
    "format:check": "prettier --check package.json packages/contracts scripts/*.mjs .github infra/compose/compose.yaml",
    "format": "prettier --write package.json packages/contracts scripts/*.mjs .github infra/compose/compose.yaml"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10"
  }
}
